{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "second-brain",
  "version": "0.1.0",
  "identifier": "com.secondbrain.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Second Brain",
        "width": 1000,
        "height": 650,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline';",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' ws: http: data: ipc:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer_hooks.nsh"
      }
    },
    "resources": {
      "../second-brain-host/target/release/second-brain-host.exe": "second-brain-host.exe"
    }
  }
}