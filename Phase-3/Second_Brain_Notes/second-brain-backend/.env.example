# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017/second-brain

# Port the backend listens on
PORT=3000

# JWT access token secret — use a long random string (e.g. openssl rand -hex 64)
ACCESS_SECRET=

# Allowed frontend origin
CLIENT_ORIGIN=http://localhost:5173

# JWT expiry duration
ACCESS_EXPIRES_IN=1h
